FROM python:3.12-slim AS builder

WORKDIR /build

RUN pip install --no-cache-dir --upgrade pip

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.12-slim AS final

RUN groupadd --system --gid 1000 ccs && \
    useradd --system --uid 1000 --gid ccs --no-create-home ccs

RUN mkdir -p /app /data /tmp/app && chown -R ccs:ccs /app /tmp/app

WORKDIR /app

COPY --from=builder /install /usr/local
COPY backend/ ./backend/
COPY data/ ./data/

EXPOSE 8000

USER 1000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-graceful-shutdown", "20"]
