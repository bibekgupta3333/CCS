{
  "name": "ccs-realtime-simulator",
  "version": "1.0.0",
  "description": "CCS Realtime Injection Simulator Dashboard",
  "scripts": {
    "start": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "source venv/bin/activate && uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload",
    "frontend": "source venv/bin/activate && python frontend/app.py",
    "setup": "python3 -m venv venv && source venv/bin/activate && pip install -r requirements.txt"
  }
}
